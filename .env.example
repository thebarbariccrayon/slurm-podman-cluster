# Site settings for docker-compose.yml. Copy to .env (gitignored) and edit;
# `make up` / `podman compose up` read it automatically.
# See docs/ldap-auth.md for details.

# --- Second cluster and federation (docs/federation.md) ----------------------
# Same as `make up FEDERATION=1`, for plain `podman compose` runs. Set both.
#FEDERATION=1
#COMPOSE_PROFILES=federation
#FEDERATION_NAME=homelab

# --- Demo directory passwords (in-stack ldap service) ------------------------
# Applied when the directory is first seeded; `make clean` to reseed.
#DEMO_ADMIN_PASSWORD=admin
#DEMO_USER_PASSWORD=demo
#LDAP_ROOT_PASSWORD=ldaproot

# --- Use an existing directory instead of the demo one -----------------------
# Used by the Slurm nodes (nslcd) and the Slurm-web gateway. Leave unset to
# use the in-stack demo directory.
#LDAP_URI=ldaps://ldap.example.org
#LDAP_USER_BASE=ou=people,dc=example,dc=org
#LDAP_GROUP_BASE=ou=groups,dc=example,dc=org

# Service account used to search the directory. Leave both unset if the
# directory allows anonymous search.
#LDAP_BIND_DN=cn=slurm-web,ou=services,dc=example,dc=org
#LDAP_BIND_PASSWORD=change-me

# LDAP groups mirrored into Slurm accounts by directory-sync.
#SLURM_ACCOUNT_GROUPS="physics biology chemistry"

# Only members of this LDAP group may sign in (one group; unset = everyone).
#LDAP_RESTRICTED_GROUPS=hpc-users

# Members of this LDAP group get the dashboard admin role and Slurm
# AdminLevel=Administrator (default: admins).
#SLURMWEB_ADMIN_GROUP=hpc-admins

# CA that signed the LDAP server certificate, if it is not a public CA.
#LDAP_CACERT_PEM="-----BEGIN CERTIFICATE-----
#...
#-----END CERTIFICATE-----"

# Use StartTLS on an ldap:// URI.
#LDAP_STARTTLS=yes

# Active Directory schema (defaults suit OpenLDAP/RFC 2307).
#LDAP_USER_CLASS=user
#LDAP_USER_NAME_ATTRIBUTE=sAMAccountName
#LDAP_USER_FULLNAME_ATTRIBUTE=displayName
#LDAP_GROUP_OBJECT_CLASSES=group
#LDAP_GROUP_NAME_ATTRIBUTE=cn
